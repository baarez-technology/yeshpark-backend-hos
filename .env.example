# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./data/glimmora.db

# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/glimmora

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379/0

# ==========================================
# Multi-Tenant Configuration (Optional)
# ==========================================
# Set MULTI_TENANT_ENABLED=true to enable multi-hotel architecture
# When enabled, each hotel has its own isolated database

# Feature flag - set to true to enable multi-tenancy
MULTI_TENANT_ENABLED=false

# Master database (stores hotel registry and global users)
# MASTER_DATABASE_URL=postgresql+asyncpg://glimmora:password@localhost:5432/glimmora_master

# Template for hotel databases (same server, different DB names)
# {db_name} will be replaced with the hotel's database name (e.g., glimmora_marriott_mumbai)
# HOTEL_DATABASE_TEMPLATE=postgresql+asyncpg://glimmora:password@localhost:5432/{db_name}

# PostgreSQL connection details (for hotel provisioning script)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=glimmora
# DB_PASSWORD=password

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL - Used for email links (password reset, pre-checkin, feedback)
# Development: http://localhost:5173
# Production: https://glimmora.ai (or your domain)
FRONTEND_URL=http://localhost:5173

# ==========================================
# Email Provider Configuration
# ==========================================
# Brevo (preferred for cloud deployments)
# - Uses HTTPS (port 443) — never blocked by cloud providers
# - 300 emails/day free, no domain verification needed
# - Get your API key at: https://app.brevo.com/settings/keys/api
# When BREVO_API_KEY is set and USE_BREVO=true, Brevo is used instead of SMTP.
USE_BREVO=true
BREVO_API_KEY=your-brevo-api-key-here
BREVO_FROM_EMAIL=baarezrpa@gmail.com
BREVO_FROM_NAME=Glimmora Hotel

# Resend (alternative — requires domain verification)
USE_RESEND=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP fallback (used when both USE_BREVO and USE_RESEND are false or
# their API keys are missing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_SENDER=baarezrpa@gmail.com
EMAIL_SENDER_PASSWORD=your-app-password-here

# Environment
ENVIRONMENT=development
DEBUG=true
